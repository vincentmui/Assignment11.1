   ],
   "source": [
    "# Prelim. correlation scan #\n",
    "# Use Pearson correlation matrix to dynamically find the numeric feature that is the second most highly correlated with target variable, price.\n",
    "# .nlargest(columns='Price', n=5): Sorts the column in descending order and returns the top 5 largest values.\n",
    "# .index[1:]: Extracts the index of 2nd item and on in sorted list (since the top item index[0], is Price = perfectly correlated with itself).\n",
    "numeric_data = clean_data.select_dtypes(include = [np.number])\n",
    "highest_corr = numeric_data.corr()[[\"price\"]].nlargest(columns = \"price\", n = 5).index[1:]\n",
    "\n",
    "print(\"=\"*100)\n",
    "print(\"DATA MODELING: PRELIM CORRELATION SCAN WITH CLEAN DATA\")\n",
    "print(\"=\"*100)\n",
    "print(\"Premlin correlatoin ranking: numeric features correlated to 'price': (High to Low)\")\n",
    "print(highest_corr)\n",
    "print(\"=\"*100)"
   ]
  },
