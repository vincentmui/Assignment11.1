   "source": [
    "# Model 5 #\n",
    "# Use Ridge regression model (L2 regularization)\n",
    "# Use GridSearchCV to determine best hyper-parameters for Ridge model, and the degree for PolynomialFeatures (for numeric features only)\n",
    "# Use StandardScaler to scale different numeric columns before feeding to Ridge model\n",
    "\n",
    "# Set up hyper-parameter dictionary: `alpha` for L2 regularizatin strength, and `degree` for ploynomial features\n",
    "param_dict = {'ridge__alpha': [0.001, 0.1, 1.0, 10.0, 100.0], 'poly_features__degree': [1, 2, 3]}\n",
    "\n",
    "pipe5 = Pipeline([\n",
    "    (\"poly_features\", PolynomialFeatures(include_bias = False)),\n",
    "    ('scale', StandardScaler()),\n",
    "    ('ridge', Ridge())\n",
    "    ])\n",
    "\n",
    "grid = GridSearchCV(pipe5, param_grid = param_dict)\n",
    "\n",
    "grid.fit(X_train[num_feature_list], y_train)\n",
    "train_preds5 = grid.predict(X_train[num_feature_list])\n",
    "test_preds5 = grid.predict(X_test[num_feature_list])\n",
    "model_5_train_mse = mean_squared_error(y_train, train_preds5)\n",
    "model_5_test_mse = mean_squared_error(y_test, test_preds5)\n",
    "# Extract best hyper-parameters\n",
    "model_5_best_params = grid.best_params_\n",
    "model_5_best_degree = list(model_5_best_params.values())[0]\n",
    "model_5_best_alpha  = list(model_5_best_params.values())[1]\n",
    "\n",
    "model_mse_rows.append({\n",
    "    \"Model\": \"Grid (Ridge w Poly)\",\n",
    "    \"Model Description\": \"GridSearchCV (Ridge Regressor + Polynomials)\",\n",
    "    \"Train MSE\": model_5_train_mse,\n",
    "    \"Test MSE\": model_5_test_mse,\n",
    "})\n",
    "\n",
    "print(\"=\"*100)\n",
    "print(\"DATA MODELING: MODEL 5\\nGridSearchCV (Ridge Regressor + Polynomials)\")\n",
    "print(\"=\"*100)\n",
    "print(f'Train MSE:  {model_5_train_mse: .2f}')\n",
    "print(f'Test MSE:   {model_5_test_mse: .2f}')\n",
    "print(f'Best Polynomial Degree: {model_5_best_degree}')\n",
    "print(f'Best Alpha: {model_5_best_alpha}')\n",
    "print(\"=\"*100)\n",
    "\n",
    "print(model_5_best_params)"
   ]
