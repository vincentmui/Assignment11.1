   "source": [
    "# Model 4 #\n",
    "# Transform numeric features to polynomials with degree = 3 (my random choice)\n",
    "# Use Sequential Feature Selector with Linear Regression to select best 4 features, \n",
    "# with a 5-fold cross-validation\n",
    "\n",
    "poly_features = PolynomialFeatures(degree = 3, include_bias = False)\n",
    "X_train_poly = poly_features.fit_transform(X_train[num_feature_list])\n",
    "X_test_poly = poly_features.transform(X_test[num_feature_list])\n",
    "columns = poly_features.get_feature_names_out()\n",
    "X_train_df = pd.DataFrame(X_train_poly, columns = columns)\n",
    "X_test_df = pd.DataFrame(X_test_poly, columns = columns)\n",
    "\n",
    "selector = SequentialFeatureSelector(\n",
    "    estimator = LinearRegression(), \n",
    "    n_features_to_select = 4, \n",
    "    cv = 5\n",
    "    )\n",
    "best_features = selector.fit_transform(X_train_df, y_train)\n",
    "best_features_df = pd.DataFrame(best_features, columns = selector.get_feature_names_out())\n",
    "# print(best_features)\n",
    "# print(best_features_df.head())\n",
    "\n",
    "model_4 = LinearRegression().fit(best_features_df, y_train)\n",
    "pred_train4 = model_4.predict(best_features_df)\n",
    "model_4_train_mse = mean_squared_error(y_train, pred_train4)\n",
    "\n",
    "best_features_test_df = pd.DataFrame(X_test_df, columns = selector.get_feature_names_out())\n",
    "# print(best_features_test.head_df())\n",
    "pred_test4 = model_4.predict(best_features_test_df)\n",
    "model_4_test_mse = mean_squared_error(y_test, pred_test4)\n",
    "\n",
    "model_mse_rows.append({\n",
    "    \"Model\": \"Feat Selector + Lin Reg\",\n",
    "    \"Model Description\": \"Linear Regression (Seq. Feature Selector)\",\n",
    "    \"Train MSE\": model_4_train_mse,\n",
    "    \"Test MSE\": model_4_test_mse,\n",
    "})\n",
    "\n",
    "print(\"=\"*100)\n",
    "print(\"DATA MODELING: MODEL 4\\nLinear Regression (Seq. Feature Selector)\")\n",
    "print(\"=\"*100)\n",
    "print(f'Train MSE: {model_4_train_mse: .2f}')\n",
    "print(f'Test MSE:  {model_4_test_mse: .2f}')\n",
    "print(\"=\"*100)\n"
   ]
