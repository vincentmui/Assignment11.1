    "# Model 2 #\n",
    "# Use a Linear Regression model fitting all features, \n",
    "#   by using a pipeline with OneHotEncoder to transform categorical features to numeric features\n",
    "\n",
    "ohe_transformer = make_column_transformer(\n",
    "    (OneHotEncoder(drop = 'if_binary'), cat_feature_list),\n",
    "    remainder='passthrough'\n",
    "    )\n",
    "\n",
    "pipe2 = Pipeline([\n",
    "        (\"transformer\", ohe_transformer),\n",
    "        (\"linreg\", LinearRegression())]\n",
    "        )\n",
    "pipe2.fit(X_train, y_train)\n",
    "pred_train2 = pipe2.predict(X_train)\n",
    "pred_test2 = pipe2.predict(X_test)\n",
    "model_2_train_mse = mean_squared_error(y_train, pred_train2)\n",
    "model_2_test_mse = mean_squared_error(y_test, pred_test2)\n",
    "\n",
    "model_mse_rows.append({\n",
    "    \"Model\": \"Lin Reg w Encoder\",\n",
    "    \"Model Description\": \"Linear Regression (encode all features)\",\n",
    "    \"Train MSE\": model_2_train_mse,\n",
    "    \"Test MSE\": model_2_test_mse,\n",
    "})\n",
    "\n",
    "# Store the coefficients and intercept for later use\n",
    "model_2_feature_list = pipe2[:-1].get_feature_names_out()\n",
    "model_2_coef_list = np.round(pipe2.named_steps['linreg'].coef_, 2)\n",
    "model_2_intercept = np.round(pipe2.named_steps['linreg'].intercept_, 2)\n",
    "model_2_features_coefs_df = pd.DataFrame({\"feature\": model_2_feature_list, \"coef\": model_2_coef_list})\n",
    "\n",
    "print(\"=\"*100)\n",
    "print(\"DATA MODELING: MODEL 2\\nLinear Regression (encode all features)\")\n",
    "print(\"=\"*100)\n",
    "print(f'Train MSE: {model_2_train_mse: .2f}')\n",
    "print(f'Test MSE:  {model_2_test_mse: .2f}')\n",
    "print(\"=\"*100)\n",
    "pipe2\n"
   ]
  },
