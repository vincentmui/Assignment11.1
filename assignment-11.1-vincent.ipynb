   "source": [
    "# Model 6 #\n",
    "# Use Lasso regression model (L1 regularization) to \"eliminate\" features \n",
    "# Use degree = 3 (best param from Model 5 above) for PolynomialFeatures (numeric features only)\n",
    "# Use StandardScaler to scale different numeric columns before feeding to Lasso model\n",
    "\n",
    "pipe6 = Pipeline([\n",
    "    (\"poly_features\", PolynomialFeatures(degree = 3, include_bias = False)),\n",
    "    (\"scale\", StandardScaler()),\n",
    "    (\"lasso\", Lasso(random_state = 42))\n",
    "    ])\n",
    "\n",
    "pipe6.fit(X_train[num_feature_list], y_train)\n",
    "\n",
    "train_preds6 = pipe6.predict(X_train[num_feature_list])\n",
    "test_preds6 = pipe6.predict(X_test[num_feature_list])\n",
    "model_6_train_mse = mean_squared_error(y_train, train_preds6)\n",
    "model_6_test_mse = mean_squared_error(y_test, test_preds6)\n",
    "\n",
    "model_mse_rows.append({\n",
    "    \"Model\": \"Lasso Reg w Poly\",\n",
    "    \"Model Description\": \"Lasso Regression + Polynomials\",\n",
    "    \"Train MSE\": model_6_train_mse,\n",
    "    \"Test MSE\": model_6_test_mse,\n",
    "})\n",
    "\n",
    "print(\"=\"*100)\n",
    "print(\"DATA MODELING: MODEL 6\\nLasso Regression + Polynomials\")\n",
    "print(\"=\"*100)\n",
    "print(f'Train MSE:  {model_6_train_mse: .2f}')\n",
    "print(f'Test MSE:   {model_6_test_mse: .2f}')\n",
    "print(\"=\"*100)\n",
    "\n",
    "pipe6\n"
   ]
