   "source": [
    "# Model 3 #\n",
    "# Transform numeric features to polynomials with degree 1 to 3,\n",
    "# Use OneHotEncoder to transform categorical features to numeric features\n",
    "# Use a pipeline to fit a Linear Regression model \n",
    "# Determine the best degree for ploynomials by comparing MSE's\n",
    "\n",
    "train_mses = []\n",
    "test_mses = []\n",
    "\n",
    "# for degree in 1 - 3\n",
    "for i in range(1, 4):\n",
    "        poly_ohe_transformer = make_column_transformer(\n",
    "                (PolynomialFeatures(degree = i, include_bias = False), make_column_selector(dtype_include = np.number)),\n",
    "                (OneHotEncoder(drop = 'if_binary'), cat_feature_list))\n",
    "        pipe3 = Pipeline([\n",
    "            (\"transformer\", poly_ohe_transformer),\n",
    "            (\"linreg\", LinearRegression())])\n",
    "        pipe3.fit(X_train, y_train)\n",
    "        pred_train3 = pipe3.predict(X_train)\n",
    "        pred_test3 = pipe3.predict(X_test)\n",
    "        train_mses.append(mean_squared_error(y_train, pred_train3))\n",
    "        test_mses.append(mean_squared_error(y_test, pred_test3))\n",
    "\n",
    "# print(train_mses)\n",
    "# print(test_mses)\n",
    "\n",
    "best_complexity_index = test_mses.index(min(test_mses))  # for locating corresponding train MSE\n",
    "best_complexity = best_complexity_index + 1              # for actual display of degree\n",
    "best_test_mse = min(test_mses)\n",
    "best_train_mse = train_mses[best_complexity_index]\n",
    "\n",
    "model_mse_rows.append({\n",
    "    \"Model\": \"Lin Reg w Poly\",\n",
    "    \"Model Description\": \"Linear Regression (best polynomials)\",\n",
    "    \"Train MSE\": best_train_mse,\n",
    "    \"Test MSE\": best_test_mse,\n",
    "})\n",
    "\n",
    "print(\"=\"*100)\n",
    "print(\"DATA MODELING: MODEL 3\\nLinear Regression (best polynomials)\")\n",
    "print(\"=\"*100)\n",
    "print(f'The best degree polynomial model is:  {best_complexity}')\n",
    "print(f'Smallest Train MSE: {best_train_mse: .2f}')\n",
    "print(f'Smallest Test MSE:  {best_test_mse: .2f}')\n",
    "print(\"=\"*100)\n",
    "pipe2\n"
   ]
