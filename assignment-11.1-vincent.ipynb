   "source": [
    "# Final Model to select top 10 \"predictive feartures\"\n",
    "# Use a Linear Regression model fitting all features, \n",
    "#   by using pipeline with OneHotEncoder to transform categorical features to numeric features\n",
    "\n",
    "# Use the same OneHotEncoder to transform categorical features to numeric features\n",
    "ohe_transformer_final = make_column_transformer(\n",
    "    (OneHotEncoder(drop = 'if_binary', sparse_output = False), cat_feature_list),\n",
    "    remainder = 'passthrough'\n",
    "    )\n",
    "\n",
    "sequential_pipe = Pipeline([\n",
    "        (\"transformer\", ohe_transformer_final),\n",
    "        (\"selector\", SequentialFeatureSelector(LinearRegression(), n_features_to_select = 10)),\n",
    "        (\"linreg\", LinearRegression())])\n",
    "sequential_pipe.fit(X_train, y_train)\n",
    "sequential_train_mse = mean_squared_error(y_train, sequential_pipe.predict(X_train))\n",
    "sequential_test_mse = mean_squared_error(y_test, sequential_pipe.predict(X_test))\n",
    "\n",
    "model_mse_rows.append({\n",
    "    \"Model\": \"Lin Reg Final Model\",\n",
    "    \"Model Description\": \"Linear Regression (Seq. Select 10 features)\",\n",
    "    \"Train MSE\": sequential_train_mse,\n",
    "    \"Test MSE\": sequential_test_mse,\n",
    "})\n",
    "\n",
    "# Check to see if this final model is as least as good as our previous best model\n",
    "better_model = True if (sequential_test_mse < model_eval_df_sorted[\"Test MSE\"][0]) else False\n",
    "\n",
