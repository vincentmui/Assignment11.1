   "source": [
    "# Clean up outliers, using Interquartile range (IQR = 𝑄3 − 𝑄1 )\n",
    "\n",
    "outlier_list = [\"price\", \"cylinders\", \"odometer\", \"age\"]\n",
    "for column_name in outlier_list:\n",
    "    q_1 = clean_data[column_name].quantile(.25)\n",
    "    q_3 = clean_data[column_name].quantile(.75)\n",
    "    iqr = q_3 - q_1\n",
    "    lower = q_1 - (1.5 * iqr)\n",
    "    upper = q_3 + (1.5 * iqr)\n",
    "    clean_data = clean_data.loc[(clean_data[column_name] > lower) & (clean_data[column_name] < upper)]\n",
    "\n",
    "clean_data.describe()"
   ]
  },
